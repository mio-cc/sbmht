[Unit]
Description=QQ desktop session supervisor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/opt/miohh/bin/miohh env-check --quiet
ExecStart=/opt/miohh/bin/miohh _serve
Restart=always
RestartSec=3
TimeoutStopSec=30
KillMode=mixed
EnvironmentFile=-/opt/miohh/config/service.env
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
Alias=miohh.service
