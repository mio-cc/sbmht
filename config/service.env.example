# miohh 服务环境变量（systemd EnvironmentFile）
# 仅本机安装使用；按需取消注释

MIOHH_DISPLAY=:1

# 统一对外入口（登录页在 /login，其余反代到 runtime WebUI）
MIOHH_GATEWAY_PORT=5099
# 内部端口（只监听 127.0.0.1，不要暴露公网）
MIOHH_WEBUI_PORT=15099
MIOHH_LOGIN_PORT=16080

# 二维码长时间不变化时自动重启 QQ（秒）；设为 0/false 关闭自动重启
# MIOHH_QR_STALE_SECONDS=180
# MIOHH_QR_AUTO_RESTART=1

# 截图模式下的自动登录：检测到"登录"按钮会尝试快速登录/勾选自动登录；
# 二维码过期会自动点刷新。设为 0/false 关闭。
# MIOHH_AUTO_LOGIN=1

# 特殊测试环境可跳过环境门禁（生产勿开）
# MIOHH_ENVCHECK_SKIP=1
